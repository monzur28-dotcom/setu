# Normalise to LF in the repository. Without this, a shell script committed
# from Windows arrives in the Linux container with CRLF endings and dies as
# "/usr/bin/env: 'bash\r': No such file or directory" — which is a confusing
# way to spend an afternoon.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
