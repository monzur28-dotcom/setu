APP_NAME=SheTu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- Platform settings (see config/setu.php) ---
SETU_DEFAULT_COUNTRY_CODE=+880
SETU_OTP_TTL_SECONDS=300
SETU_OTP_MAX_ATTEMPTS=3
# Skips the SMS code screen. Local development only — RegisterController
# also requires APP_ENV=local, so setting this on a real host does nothing.
SETU_OTP_BYPASS=false
SETU_LANDING_MIN_PROFILES=8
SETU_PHOTO_MODERATION_SLA_HOURS=4

# --- SMS (BTRC-approved aggregator) ---
SMS_DRIVER=log
SMS_SENDER_ID=SETU
SMS_API_URL=
SMS_API_KEY=

# --- Payments ---
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
STRIPE_KEY=
STRIPE_SECRET=

# --- Identity verification vendor ---
KYC_DRIVER=manual
KYC_API_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@setu.example"
MAIL_FROM_NAME="${APP_NAME}"
