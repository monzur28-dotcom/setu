APP_NAME=SheTu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -------------------------------------------------------------
# Local development uses SQLite. Production is PostgreSQL (Supabase).
#
# With Supabase, set DB_CONNECTION=pgsql and paste the connection string into
# DB_URL — it carries host, port, database, user and password together, so
# the five variables below are only for a hand-rolled server.
#
# Use the SESSION pooler or the direct connection. NOT the transaction
# pooler on port 6543: it hands a different backend to each statement, which
# breaks the prepared statements Laravel's PDO driver depends on.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_CONNECTION=pgsql
# DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# DB_SSLMODE=require
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# --- Member media ---------------------------------------------------------
# `local` writes to storage/app. On a container that filesystem resets on
# every redeploy, so member photographs survive until the next deploy and no
# longer. Set MEDIA_DRIVER=s3 and point it at Supabase Storage in production.
#
# Create the buckets PRIVATE. This application serves media only through
# short-lived signed URLs; a public bucket bypasses that entirely and nothing
# in the code will warn you.
MEDIA_DRIVER=local
# MEDIA_DRIVER=s3
# MEDIA_S3_ENDPOINT=https://PROJECT.supabase.co/storage/v1/s3
# MEDIA_S3_REGION=us-east-1
# MEDIA_S3_KEY=
# MEDIA_S3_SECRET=
# MEDIA_S3_BUCKET=member-photos
# MEDIA_S3_CONNECT_BUCKET=connect-photos
# MEDIA_S3_KYC_BUCKET=kyc-documents

# --- Platform settings (see config/setu.php) ------------------------------
SETU_HOME_MARKET=US
SETU_DEFAULT_COUNTRY_CODE=+1
SETU_PROFILE_ID_PREFIX=ST
SETU_COMPANY_NAME="Royal Bengal AI"
SETU_COMPANY_COUNTRY=US
SETU_SUPPORT_EMAIL=hello@shetu.example

SETU_OTP_TTL_SECONDS=300
SETU_OTP_MAX_ATTEMPTS=3
# Skips the SMS code screen. Local development only — RegisterController
# also requires APP_ENV=local, so setting this on a real host does nothing.
SETU_OTP_BYPASS=false

SETU_LANDING_MIN_PROFILES=8
SETU_PHOTO_MODERATION_SLA_HOURS=4
SETU_HERO_INTERVAL_MS=3000

# Forty invented members with invented photographs. Off in production unless
# this is explicitly true, so forgetting it leaves you with an empty site
# rather than a public one full of people who do not exist.
SETU_SEED_DEMO=false

# The password every seeded account gets. Leave blank in production and one
# is generated and printed once in the deploy log — there is no way to read
# it back afterwards, so copy it when you see it.
SETU_SEED_PASSWORD=

# --- SMS ------------------------------------------------------------------
# `log` writes the message to storage/logs/laravel.log instead of sending it.
SMS_DRIVER=log
SMS_SENDER_ID=SHETU
SMS_API_URL=
SMS_API_KEY=

# --- Payments -------------------------------------------------------------
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_SANDBOX=true
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
STRIPE_KEY=
STRIPE_SECRET=

# --- Identity verification vendor -----------------------------------------
KYC_DRIVER=manual
KYC_API_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@shetu.example"
MAIL_FROM_NAME="${APP_NAME}"
